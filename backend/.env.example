# SocialSync Official Social Media Integration Configuration
# Copy this file to backend/.env and fill in your real Developer App credentials.
# NEVER commit backend/.env or expose secrets in frontend code.

# --- Core Backend Security ---
SECRET_KEY=replace_with_a_long_random_secret_string
TOKEN_ENCRYPTION_KEY=replace_with_a_32plus_char_encryption_secret
PORT=5000

# Backend & Frontend URLs used to construct OAuth Redirect URIs
OAUTH_REDIRECT_BASE=http://127.0.0.1:5000
FRONTEND_URL=http://localhost:5173

# Optional public HTTPS tunnel URL (e.g., https://your-subdomain.ngrok-free.app)
# Required ONLY if publishing local uploaded files to Instagram Graph API,
# because Meta's servers must fetch image_url / video_url over the public internet.
PUBLIC_BASE_URL=

# --- Meta App Credentials (Facebook Pages + Instagram Graph API via Facebook Login) ---
# Create at: https://developers.facebook.com/apps/
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# Optional: Facebook Login for Business Configuration ID (if your Meta app uses config_id)
META_LOGIN_CONFIG_ID=

# --- Optional: Direct Instagram Login App Credentials ---
# Use ONLY if configuring "Instagram API with Instagram Login" (api.instagram.com)
# instead of "Instagram API with Facebook Login".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Google / YouTube Data API v3 & Analytics API Credentials ---
# Create OAuth 2.0 Web Application Client ID at: https://console.cloud.google.com/apis/credentials
# Enable: YouTube Data API v3 and YouTube Analytics API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

